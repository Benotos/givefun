# Never commit real values. Set these in Vercel env vars (and on the worker host).

# Kill switch: 1 shows the maintenance page on every route except /api/health
MAINTENANCE=0

# Demo: 1 runs on fictional seeded data with a banner. Never set in production.
DEMO_MODE=0

# Public site URL (used in metadata and links)
NEXT_PUBLIC_SITE_URL=https://givefun.vercel.app

# DATABASE: use ONE of the two options below.
# Option A, Neon or any Postgres (free tier available). Run postgres/schema.sql once. Use the POOLED connection string.
DATABASE_URL=
# Option B, Supabase. Run supabase/schema.sql, then supabase/migrations/002_scale_admin.sql
# (If DATABASE_URL is set it wins and Supabase is ignored.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (pay as you go, set a monthly budget cap of 20 dollars). Cache, locks, rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RPC. Primary plus extra comma separated fallbacks (free tiers from other providers). Server side only.
HELIUS_RPC_URL=
RPC_URLS=

# Split config (basis points of total creator fees). Charity share is chosen by the dev, 50 to 100 percent.
PLATFORM_BPS=0
PLATFORM_WALLET=

# Worker only: wallet that pays tx fees for distribute calls (JSON array secret key). Keep a tiny balance.
WORKER_SECRET_KEY=
WORKER_INTERVAL_SECONDS=60

# Metadata upload endpoint for new coins
METADATA_UPLOAD_URL=https://pump.fun/api/ipfs

# Signs launch tickets so clients cannot spoof coin metadata. Random 32+ chars.
REGISTER_SECRET=

# Admin login at /admin. Password 20+ random chars. Session secret 32+ random chars.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
